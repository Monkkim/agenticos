{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume",
        "hooks": [
          {
            "type": "command",
            "command": "echo '[agentic-os] 세션 시작. skills/ops/heartbeat/SKILL.md 절차에 따라 정합성 체크를 수행하세요.'"
          }
        ]
      }
    ],
    "Stop": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "echo '[agentic-os] 세션을 마치려면 \\\"세션 종료\\\" 또는 \\\"wrap up\\\"이라고 말해 skills/ops/wrap-up을 호출하세요.'"
          }
        ]
      }
    ]
  }
}
